@model QualityDocc.Domain.Entities.Document

<div class="container mt-4">
    <h2 class="mb-4" style="color: #4a3b32;">Revisión de Documento: QD-@Model.Id</h2>
    <hr style="border-color: #9b9564; border-width: 2px;" />

    <div class="row mt-4">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 p-4" style="background-color: #fcfaf5; border-radius: 12px;">
                <h4 style="color: #6e4c30;" class="mb-3">@Model.Title</h4>
                <p class="mb-2"><strong>Categoría:</strong> @(Model.Category?.Name ?? "N/A")</p>
                <p class="mb-2"><strong>Descripción:</strong> @Model.Description</p>
                <p class="mb-0"><strong>Última Versión:</strong> @(Model.Versions?.OrderByDescending(v => v.VersionNumber).FirstOrDefault()?.VersionNumber.ToString("0.0") ?? "-")</p>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0 p-4" style="border-radius: 12px;">
                <form asp-action="ProcessReview" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold" style="color: #4a3b32;">Notas de revisión (Obligatorio si se rechaza):</label>
                        <textarea name="notes" class="form-control" rows="6" placeholder="Escribe aquí los cambios que el autor debe realizar para que el documento sea aprobado..."></textarea>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mt-2" })
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" name="actionType" value="Aprobar" class="btn text-white w-50 py-2 fw-bold" style="background-color: #9b9564; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                            Aprobar Documento
                        </button>

                        <button type="submit" name="actionType" value="Rechazar" class="btn text-white w-50 py-2 fw-bold" style="background-color: #6e4c30; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                            Devolver al Autor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>