@model IEnumerable<QualityDocc.MVC.Models.DTOs.DocumentDto> // Cambiar al DTO correspondiente si varía el nombre
@{
    ViewData["Title"] = "Panel de Control de Documentos - QualityDoc";
}

<div class="container-fluid py-4 animate-fade-in" style="background-color: #1A130E; min-height: 100vh; color: #F5EBE1; font-family: 'Lato', sans-serif;">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid rgba(245, 235, 225, 0.15);">
        <div>
            <h1 style="font-family: 'Playfair Display', serif; font-weight: 700; color: #F5EBE1; margin: 0;">Gestión Core de Documentos</h1>
            <p class="text-muted mb-0" style="color: #C2B3A5 !important; font-style: italic;">Ciclo de vida normativo e integridad de versiones (SQL Server)</p>
        </div>
        <div>
            <button class="btn px-4 py-2" style="background-color: #4A372C; color: #F5EBE1; border: 1px solid rgba(245, 235, 225, 0.3); border-radius: 8px; font-family: 'Playfair Display', serif;" data-bs-toggle="modal" data-bs-target="#newDocumentModal">
                <i class="bi bi-file-earmark-plus-fill me-2"></i> Nuevo Documento (v0.1)
            </button>
        </div>
    </div>

    <div class="card shadow-lg" style="background-color: rgba(74, 55, 44, 0.4); border: 1px solid rgba(245, 235, 225, 0.2); border-radius: 12px; backdrop-filter: blur(10px);">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="color: #F5EBE1; vertical-align: middle;">
                    <thead style="background-color: #241A13; color: #C2B3A5; font-family: 'Playfair Display', serif;">
                        <tr>
                            <th class="ps-4 py-3">Código / ID</th>
                            <th class="py-3">Título del Documento</th>
                            <th class="py-3 text-center">Versión Actual</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="py-3">Último Cambio</th>
                            <th class="pe-4 py-3 text-end">Acciones de Flujo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="border-bottom: 1px solid rgba(245, 235, 225, 0.1);">
                            <td class="ps-4 font-monospace" style="color: #C2B3A5;">QD-0042</td>
                            <td class="fw-bold">Manual de Procedimientos de Auditoría Interna</td>
                            <td class="text-center"><span class="badge px-3 py-2" style="background-color: rgba(194, 179, 165, 0.15); color: #C2B3A5; border: 1px solid rgba(194, 179, 165, 0.3);">0.1</span></td>
                            <td class="text-center"><span class="badge bg-warning text-dark px-2 py-1.5 fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">BORRADOR</span></td>
                            <td>Hace 10 min <small class="d-block text-muted" style="color: #C2B3A5 !important;">Por: Admin</small></td>
                            <td class="pe-4 text-end">
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-outline-light" title="Incrementar Minor Version (v0.2)" style="border-color: rgba(245, 235, 225, 0.2); color: #F5EBE1;"><i class="bi bi-plus-circle-fill"></i> v++</button>
                                    <button class="btn btn-sm btn-success" title="Aprobar (Pasar a v1.0)" style="background-color: #2E5A44; border: none;" data-bs-toggle="modal" data-bs-target="#approveModal"><i class="bi bi-check-circle-fill"></i> Aprobar</button>
                                </div>
                            </td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(245, 235, 225, 0.1);">
                            <td class="ps-4 font-monospace" style="color: #C2B3A5;">QD-0015</td>
                            <td class="fw-bold">Política de Seguridad y Control Ambiental ANSI</td>
                            <td class="text-center"><span class="badge px-3 py-2" style="background-color: rgba(245, 235, 225, 0.1); color: #F5EBE1; border: 1px solid #F5EBE1;">1.0</span></td>
                            <td class="text-center"><span class="badge bg-success px-2 py-1.5 fw-semibold" style="background-color: #1b4332 !important; font-size: 0.75rem; letter-spacing: 0.5px;">APROBADO</span></td>
                            <td>24 May 2026 <small class="d-block text-muted" style="color: #C2B3A5 !important;">Por: Auditor Jefe</small></td>
                            <td class="pe-4 text-end">
                                <button class="btn btn-sm btn-secondary" style="background-color: #241A13; border: 1px solid rgba(245, 235, 225, 0.2); color: #C2B3A5;" disabled><i class="bi bi-lock-fill"></i> Bloqueado</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #4A372C; color: #F5EBE1; border: 1px solid rgba(245, 235, 225, 0.3);">
            <div class="modal-header" style="border-bottom: 1px solid rgba(245, 235, 225, 0.15);">
                <h5 class="modal-title" style="font-family: 'Playfair Display', serif;">Aprobación Formal de Documento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-shadow="none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted" style="color: #C2B3A5 !important;">Al aprobar, el estado cambiará a <strong>Aprobado</strong> y la versión se consolidará automáticamente a <strong>1.0</strong>.</p>
                <div class="mb-3">
                    <label class="form-label font-monospace small" style="color: #C2B3A5;">NOTAS DE APROBACIÓN (OBLIGATORIO):</label>
                    <textarea class="form-control" rows="3" style="background-color: #1A130E; color: white; border: 1px solid rgba(245, 235, 225, 0.2);" placeholder="Escriba los comentarios o justificación técnica de la aprobación..." required></textarea>
                </div>
            </div>
            <div class="modal-content-footer p-3 text-end" style="border-top: 1px solid rgba(245, 235, 225, 0.15);">
                <button type="button" class="btn btn-sm btn-outline-light me-2" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-success" style="background-color: #2E5A44; border: none;">Confirmar y Publicar v1.0</button>
            </div>
        </div>
    </div>
</div>