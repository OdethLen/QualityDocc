<a hr@if (User.IsInRole("Author"))
   {
    <a href="/Author/Index" class="nav-link"><i class="bi bi-house"></i> Home</a>
    <a href="/Author/Upload" class="nav-link"><i class="bi bi-upload"></i> Upload</a>
    <a href="/Author/Search" class="nav-link"><i class="bi bi-search"></i> Search</a>
    }

    @if (User.IsInRole("Reviewer"))
    {
        <a href="/Reviewer/Index" class="nav-link"><i class="bi bi-clipboard-check"></i> Panel de Auditoría</a>
    }

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <hr class="text-white opacity-50 my-4" style="border-width: 1px;" />

        <a href="/Auth/Logout" class="nav-link text-danger" style="transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <i class="bi bi-box-arrow-left"></i> Cerrar Sesión
        </a>
    }