@model QualityDocc.Domain.Entities.Document

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<style>
    .drop-zone {
        width: 100%;
        height: 180px;
        border: 2px dashed #6c757d;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #f8f9fa;
        cursor: pointer;
        transition: all 0.3s;
    }

        .drop-zone:hover {
            border-color: #007bff;
            background-color: #e9ecef;
        }

        .drop-zone i {
            font-size: 50px;
            color: #6c757d;
        }

    .version-input {
        font-weight: bold;
        text-align: center;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4" style="background-color: #4A372C; border: 1px solid rgba(245, 235, 225, 0.15);">
                <h2 class="text-white mb-4" style="font-family: 'Cinzel Decorative', serif;">Subir Documento</h2>

                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label class="form-label text-white">Título</label>
                        <input asp-for="Title" class="form-control" placeholder="Nombre del documento..." required />
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label text-white">Categoría (ISO)</label>
                                <select asp-for="CategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))" required>
                                    <option value="">-- Seleccione categoría --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label text-white">Versión</label>
                                <div class="input-group">
                                    <button type="button" class="btn btn-outline-light btn-sm" onclick="changeVersion(-0.1)">-</button>
                                    <input type="text" id="versionDisplay" name="VersionNumber" value="0.1" class="form-control form-control-sm version-input" readonly />
                                    <button type="button" class="btn btn-outline-light btn-sm" onclick="changeVersion(0.1)">+</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white">Archivo (PDF o DOCX)</label>
                        <div class="drop-zone" onclick="document.getElementById('fileInput').click()">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <p class="mt-2 text-muted">Arrastra tus archivos aquí o haz clic para buscar</p>
                            <div id="fileInfo" class="text-primary font-weight-bold"></div>
                        </div>
                        <input type="file" id="fileInput" name="archivo" class="d-none" accept=".pdf,.docx" required onchange="showFileName(this)">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white">Descripción</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white">¿Qué cambios realizaste en esta versión? (ChangeLog)</label>
                        <textarea name="ChangeLog" class="form-control" rows="2" placeholder="Ej: Se actualizó el índice y se corrigieron referencias..." required></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" name="action" value="save" class="btn btn-secondary w-100 py-2">Guardar en Servidor</button>
                        <button type="submit" name="action" value="submit" class="btn btn-primary w-100 py-2">Enviar al Autorizador</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function showFileName(input) {
        if (input.files.length > 0) {
            document.getElementById('fileInfo').innerText = "Seleccionado: " + input.files[0].name;
        }
    }

    // Nueva lógica de versión con límite de 0.1
    function changeVersion(amount) {
        let input = document.getElementById('versionDisplay');
        let currentVal = parseFloat(input.value);
        let newVal = Math.round((currentVal + amount) * 10) / 10;

        if (newVal >= 0.1) {
            input.value = newVal.toFixed(1);
        }
    }
</script>