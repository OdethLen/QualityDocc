@model IEnumerable<QualityDocc.Domain.Entities.Document>

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container mt-4">
    <h2 class="text-white mb-4" style="font-family: 'Cinzel Decorative', serif;">Archivo Documental</h2>

    <form asp-action="Search" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="busqueda" class="form-control" placeholder="Buscar por título...">
            <button class="btn btn-luxe" type="submit">Buscar</button>
        </div>
    </form>

    <div class="card p-3" style="background-color: rgba(74, 55, 44, 0.5); border: 1px solid rgba(194, 179, 165, 0.2);">
        <table class="table table-dark table-hover" style="background: transparent;">
            <thead>
                <tr style="color: var(--muted-champagne);">
                    <th>Título</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="color: var(--champagne-ivory);">@item.Title</td>
                        <td>@item.DateCreate?.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a href="#" class="btn btn-sm btn-outline-light">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>